{
  "name": "remote-harness-for-vms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w @remote-harness/hub",
    "dev:web": "npm run dev -w @remote-harness/web",
    "dev:agent": "npm run dev -w @remote-harness/agent",
    "build:web": "npm run build -w @remote-harness/web",
    "gen:icons": "node scripts/gen-icons.mjs && npm exec -w @remote-harness/web -- capacitor-assets generate --android --assetPath assets",
    "build:apk": "npm run android:apk -w @remote-harness/web",
    "dev:worker": "npm run dev -w @remote-harness/worker",
    "deploy:worker": "npm run deploy -w @remote-harness/worker",
    "test": "node --experimental-strip-types --test packages/shared/test/*.test.ts && npm run test -w @remote-harness/hub",
    "test:integration": "npm run test:integration -w @remote-harness/agent"
  }
}
