# WebSocket URL of your hub's agent endpoint, e.g. wss://hub.example.com/agent
HUB_URL=ws://localhost:8787/agent

# Shared secret configured on the hub (HUB_AGENT_TOKEN there). Every agent
# you install uses this same token.
HUB_TOKEN=change-me

# Friendly name shown in the app. Defaults to the machine hostname.
VM_NAME=

# Sessions may only be opened with a working directory inside this root.
WORKSPACE_ROOT=/home/ubuntu

# Where the agent keeps its local session registry.
DATA_DIR=./data

# Each subdirectory here is exposed as a separate Claude account (its own
# CLAUDE_CONFIG_DIR, so its own login/credentials). install.sh sets these up
# for you and creates matching claude1/claude2/... aliases in ~/.bashrc. If
# this directory is empty or missing, the agent uses one account: whatever
# is already logged in normally (~/.claude).
#
# Already manage multiple accounts yourself (e.g. `claude1='CLAUDE_CONFIG_DIR=
# ~/.claude-account-1 claude'` in your ~/.bashrc)? Symlink them in instead of
# re-running setup: ln -s ~/.claude-account-1 $PROFILES_DIR/claude1
PROFILES_DIR=/home/ubuntu/.claude-profiles

# Required unless this machine already has an interactively-logged-in Claude
# Code session (~/.claude credentials). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
