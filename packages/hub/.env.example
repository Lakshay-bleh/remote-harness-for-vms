PORT=8787

# Shared secret every agent must present. Put the same value in each VM's
# packages/agent/.env as HUB_TOKEN.
HUB_AGENT_TOKEN=change-me

# Password to sign in to the app itself (single-user, personal use).
APP_PASSWORD=change-me

DATA_DIR=./data

# Directory of the built web app (packages/web/dist) to serve. Leave default
# unless you moved things around.
WEB_DIST=../web/dist

# Escanor API used to verify "Sign in with Google" tokens from the app.
ESCANOR_API_URL=https://api.escanor.in/api/v1

# The first Escanor account to sign in owns this hub. Extra emails (comma separated)
# that may also sign in.
HUB_ALLOWED_EMAILS=

# Set to 1 only when the hub is behind a reverse proxy you control that sets
# X-Forwarded-For; the login rate limiter then keys on the real client address.
TRUST_PROXY=

# Dev only: allow the Escanor MCP URL to be a loopback/private-network address.
ESCANOR_MCP_ALLOW_PRIVATE=

# Optional: key used to encrypt the stored Escanor MCP token. Defaults to HUB_AGENT_TOKEN; set it
# explicitly if you rotate HUB_AGENT_TOKEN so the saved token stays readable.
HUB_ENCRYPTION_KEY=
