PORT=8787

# Shared secret every agent must present. Put the same value in each VM's
# packages/agent/.env as HUB_TOKEN.
HUB_AGENT_TOKEN=change-me

# Password to sign in to the app itself (single-user, personal use).
APP_PASSWORD=change-me

DATA_DIR=./data

# Directory of the built web app (packages/web/dist) to serve. Leave default
# unless you moved things around.
WEB_DIST=../web/dist

# ---- Hardening (all optional) ----

# Generate real secrets, e.g. `openssl rand -hex 32`. The hub refuses to start with a placeholder
# ("change-me") or anything shorter than 24 characters, including HUB_ADMIN_TOKEN when it is set.

# Key used to encrypt the MCP server credentials stored in the database. Defaults to HUB_AGENT_TOKEN; set it
# explicitly if you rotate HUB_AGENT_TOKEN so the saved credentials stay readable.
HUB_ENCRYPTION_KEY=

# Set to 1 only when the hub is behind a reverse proxy you control that sets X-Forwarded-For; the sign-in
# rate limiter then keys on the real client address instead of the proxy's.
TRUST_PROXY=

# Failed sign-ins per address (per 15 minutes) before further attempts are refused.
HUB_LOGIN_MAX_FAILURES=10

# Dev only: allow an MCP server URL on loopback / a private network. Cloud-metadata addresses are always refused.
HUB_MCP_ALLOW_PRIVATE=

# Old app builds sent the browser token in the /ws URL (it ends up in proxy and CDN logs). Off unless you set 1.
HUB_ALLOW_QUERY_TOKEN=
