<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plain http/ws is needed for ONE thing: talking to your own computer on your own Wi-Fi (the desktop app's local gateway, whose
         messages are sealed with a key only the two of you hold). The app refuses to use it for anything else: the Escanor API and
         hubs must be https, and local-network addresses are the only plain addresses it will open (see isLocalAddress). -->
    <!-- The voice assistant opens apps by name, so it must be able to see which apps have a launcher icon (not the whole package list). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in returns here: escanor://auth/login?code=... (from escanor.in/auth/mobile/login) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="escanor" android:host="auth" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
            <!-- the QR scanner (Google code scanner): lets Google Play fetch it when the app is installed, so the first scan is instant -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <!-- where Firebase puts notifications that arrive while the app is closed; the app creates this channel at start -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="escanor_alerts" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_escanor" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_accent" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning the pairing code shown by Escanor Desktop. The camera is optional: typing the code works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- push notifications (Android 13+ asks the person at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- voice: set alarms and timers; the microphone for speaking to Escanor; contacts are asked for only when you call someone by name -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- haptic feedback (Settings > Appearance and feel) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
